# Cloudflare Pages HTTP Headers Configuration

# 1. Global Security Headers & Base Configuration
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=()

# 2. HTML Documents (Immediate revalidation, zero stale pages)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 3. Static Media Assets (WebP, PNG, SVG, MP4) - 1 Year Immutable Cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 4. Service Worker (Self-destruct / Never cache)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# 5. Web App Manifest
/manifest.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
