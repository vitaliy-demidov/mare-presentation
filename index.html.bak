<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Maison Textile | Ателье Интерьерного Текстиля (Астана) — ТОП-50 Мировых Декораторов</title>
  <meta name="description" content="ТОП-50 мировых декораторов интерьерного текстиля. 12 лет в Астане, собственный швейный цех 350 м², ткани Бельгии и Италии, Voice AI расчет штор и партнерский клуб дизайнеров с кэшбэком 10%.">
  
  <!-- Fonts: Cormorant Garamond (Haute Couture Serif) & Inter (Precision Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ecru: '#F7F5F0',
            ecruDark: '#EFECE6',
            obsidian: '#0B0C0E',
            obsidianLight: '#181A1F',
            brass: '#9E8255',
            brassLight: '#C5A880',
            brassDark: '#76603B',
            borderSubtle: 'rgba(21, 20, 19, 0.08)',
            borderBrass: 'rgba(158, 130, 85, 0.28)',
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Inter"', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="styles.css">
</head>
<body class="selection:bg-brass selection:text-white bg-ecru text-obsidian relative">

  <!-- ============================================================ -->
  <!-- TOP STATUS BAR: ДВЕ ДВЕРИ & СТАТУС ЦЕХА                      -->
  <!-- ============================================================ -->
  <aside aria-label="Статус цеха" class="border-b border-borderSubtle bg-ecruDark/80 text-[11px] tracking-wider uppercase font-medium py-2 px-4 text-obsidian/80">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span id="topDoorBadge">Собственный цех 350 м² в Астане: открыт прием заказов на сезон 2026-2027</span>
      </div>
      <div class="flex items-center gap-4 sm:gap-6">
        <button onclick="openSecretKP()" class="text-brass hover:text-brassDark font-bold flex items-center gap-1.5 transition-colors">
          <span>🔑</span>
          <span>Личный проект (Код КП)</span>
        </button>
        <span class="text-obsidian/30 hidden sm:inline">|</span>
        <a href="#powers" class="hidden sm:inline text-obsidian/70 hover:text-brass transition-colors">7 Сил Студии &darr;</a>
      </div>
    </div>
  </aside>

  <!-- ============================================================ -->
  <!-- HEADER С БРЕНД-СИМВОЛОМ «РЫБЫ» И СЕЛЕКТОРОМ «ДВЕ ДВЕРИ»      -->
  <!-- ============================================================ -->
  <header class="sticky top-0 z-40 bg-ecru/95 backdrop-blur-md border-b border-borderSubtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo: Новая эмблема «РЫБЫ» + Couture Typography -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-11 h-11 border border-borderBrass bg-white flex items-center justify-center text-brass group-hover:border-brass transition-colors shadow-sm">
          <svg class="w-7 h-7 fill-current" viewBox="0 0 48 48">
            <!-- Пластика пары шелковых рыб (Рыбы вместо старых цветов) -->
            <path d="M14 12C18 8 26 8 30 14C32 17 31 22 28 25C25 28 20 28 17 31C14 34 14 39 18 42C12 39 10 32 12 26C14 21 18 19 21 16C24 13 22 10 18 10C16 10 14 11 14 12Z" opacity="0.9"/>
            <path d="M34 36C30 40 22 40 18 34C16 31 17 26 20 23C23 20 28 20 31 17C34 14 34 9 30 6C36 9 38 16 36 22C34 27 30 29 27 32C24 35 26 38 30 38C32 38 34 37 34 36Z" opacity="0.5"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-2xl font-bold tracking-tight text-obsidian uppercase leading-tight">Maison Textile</span>
          <span class="text-[9px] tracking-[0.28em] uppercase text-brass font-sans font-bold -mt-0.5">Top-50 World Decorators • Астана</span>
        </div>
      </a>

      <!-- ДВЕ ДВЕРИ: СЕГМЕНТИРОВАННЫЙ ПЕРЕКЛЮЧАТЕЛЬ -->
      <div class="hidden lg:flex items-center p-1 bg-ecruDark rounded-full border border-borderSubtle">
        <button id="doorBtnB2C" onclick="switchDoor('b2c')" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-obsidian text-white shadow-sm transition flex items-center gap-2">
          <span>🏡</span>
          <span>Частные Резиденции (B2C)</span>
        </button>
        <button id="doorBtnB2B" onclick="switchDoor('b2b')" class="px-5 py-2.5 rounded-full text-xs font-medium text-obsidian/70 hover:text-obsidian transition flex items-center gap-2">
          <span>🏢</span>
          <span>Бизнес & Юрлица (B2B)</span>
        </button>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <button onclick="openSamplerModal()" class="hidden sm:inline-flex items-center gap-2.5 bg-obsidian hover:bg-brass text-white px-5 py-3 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-sm">
          <span>Чемодан 50 кг на объект</span>
        </button>

        <button onclick="openWhatsAppModal()" class="inline-flex items-center gap-2 border border-borderBrass bg-brass/10 hover:bg-brass hover:text-white text-brassDark px-4 py-3 text-xs uppercase tracking-widest font-semibold transition-all duration-300">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.77.781 2.796.782 3.182 0 5.768-2.587 5.768-5.766.001-3.182-2.585-5.768-5.768-5.768zm0 10.457c-.89 0-1.636-.25-2.395-.699l-.171-.102-1.782.467.476-1.737-.113-.18c-.482-.767-.736-1.558-.735-2.439.001-2.584 2.103-4.686 4.72-4.686 2.617 0 4.719 2.102 4.719 4.686 0 2.585-2.102 4.688-4.714 4.69z"/>
          </svg>
          <span class="hidden md:inline">WhatsApp</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ============================================================ -->
  <!-- ACT 1: HERO SECTION С ПРОЦЕДУРНЫМ ШЕЛКОВЫМ ХОЛСТОМ И РЫБАМИ    -->
  <!-- ============================================================ -->
  <section class="py-16 md:py-24 border-b border-borderSubtle relative overflow-hidden fish-watermark">
    <!-- Procedural Silk Waves & Koi Canvas Background -->
    <canvas id="silkBackgroundCanvas"></canvas>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-8">
          <div class="inline-flex items-center gap-2 border border-borderBrass bg-brass/5 text-brassDark text-[11px] uppercase tracking-widest font-semibold px-3.5 py-1.5 mb-6">
            <span class="w-1.5 h-1.5 bg-brass rounded-full animate-ping"></span>
            <span>Интерьерный текстиль высокой моды • Астана</span>
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-obsidian leading-[1.12] mb-6 text-balance">
            Архитектура текстиля для тех, кто не терпит полумер: <span class="italic font-normal font-serif text-brass">12 лет кутюрного мастерства.</span>
          </h1>

          <p class="text-base sm:text-lg text-obsidian/75 font-normal max-w-2xl leading-relaxed mb-8">
            Мы входим в официальный рейтинг ТОП-50 мировых интерьерных декораторов. Собственный швейный цех 350 м² в Астане, прямые поставки шенилла и шелка из Европы (Dedar, Rubelli, Wind), расчет голосом без клавиатуры и честный кэшбэк 10% архитекторам.
          </p>

          <!-- Quick Navigation Pills -->
          <div class="flex flex-wrap gap-3 mb-10">
            <a href="#calculator" class="bg-obsidian hover:bg-brass text-white text-xs uppercase tracking-wider font-semibold px-5 py-3 transition-colors shadow-sm">
              Интерактивный калькулятор складок &darr;
            </a>
            <a href="#voice-ai" class="border border-borderBrass bg-white hover:bg-brass/10 text-obsidian text-xs uppercase tracking-wider font-semibold px-5 py-3 transition-colors flex items-center gap-2">
              <span>🎙️</span>
              <span>Расчет голосом (Voice AI)</span>
            </a>
            <button onclick="openSecretKP()" class="border border-borderSubtle bg-white hover:border-brass text-obsidian/80 text-xs uppercase tracking-wider font-semibold px-5 py-3 transition-colors">
              Ввести код КП объекта &rarr;
            </button>
          </div>

          <!-- Metrics Panel -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-8 border-t border-borderSubtle">
            <div>
              <div class="font-serif text-3xl sm:text-4xl font-bold text-obsidian">ТОП-50</div>
              <div class="text-[11px] uppercase tracking-wider text-obsidian/60 mt-1">Мировых декораторов</div>
            </div>
            <div>
              <div class="font-serif text-3xl sm:text-4xl font-bold text-obsidian">350 м²</div>
              <div class="text-[11px] uppercase tracking-wider text-obsidian/60 mt-1">Цех в Астане</div>
            </div>
            <div>
              <div class="font-serif text-3xl sm:text-4xl font-bold text-brass">10%</div>
              <div class="text-[11px] uppercase tracking-wider text-brassDark font-bold mt-1">Кэшбэк дизайнерам</div>
            </div>
            <div>
              <div class="font-serif text-3xl sm:text-4xl font-bold text-obsidian">3 года</div>
              <div class="text-[11px] uppercase tracking-wider text-obsidian/60 mt-1">Гарантия по договору</div>
            </div>
          </div>
        </div>

        <!-- Right Side: Action Card (High-Ticket Lead) -->
        <div class="lg:col-span-4 bg-white p-8 border border-borderBrass couture-card shadow-sm relative">
          <div class="absolute -top-3 right-6 bg-brass text-white text-[10px] uppercase font-bold tracking-widest py-1 px-3">
            Сервис White Glove
          </div>
          <h2 class="font-serif text-2xl font-bold text-obsidian mb-2">Примерка в вашем интерьере</h2>
          <p class="text-xs text-obsidian/70 leading-relaxed mb-6">
            Закажите выезд ведущего декоратора с мобильной библиотекой (50 кг каталогов) прямо к вам на объект в Астане.
          </p>
          
          <div class="space-y-3 mb-6 text-xs text-obsidian/85">
            <div class="flex items-center gap-2.5">
              <span class="text-brass font-bold">✓</span> 400+ каталогов под вашу цветовую палитру
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brass font-bold">✓</span> Лазерный замер скрытых ниш с точностью 1 мм
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brass font-bold">✓</span> 3D-моделирование драпировок на стадии бетона
            </div>
          </div>

          <button onclick="openSamplerModal()" class="w-full bg-obsidian hover:bg-brass text-white text-xs uppercase tracking-widest font-semibold py-4 transition-all duration-300">
            Забронировать дату выезда
          </button>
          <div class="text-[11px] text-center text-obsidian/50 mt-2.5">Бесплатно при согласовании проекта</div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- ACT 2: «ДВЕ ДВЕРИ» (B2C РЕЗИДЕНЦИИ VS B2B БИЗНЕС & ЮРЛИЦА)  -->
  <!-- ============================================================ -->
  <section class="py-16 md:py-24 bg-ecru border-b border-borderSubtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-[0.25em] text-brass font-bold mb-2 block">Архитектура выбора</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-obsidian tracking-tight mb-4">
          Две Двери: Решения для частных домов и корпоративных объектов
        </h2>
        <p class="text-sm sm:text-base text-obsidian/70 leading-relaxed">
          Мы разделили производственные потоки, чтобы частные заказчики получали кутюрный уют, а корпоративные клиенты — жесткие SLA, сертификаты МЧС и закрывающие документы.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Door 1: B2C Резиденции -->
        <div class="bg-white p-8 sm:p-10 border border-borderSubtle couture-card relative flex flex-col justify-between">
          <div class="flex justify-between items-start mb-6">
            <span class="font-serif text-4xl font-light text-brass/40">01</span>
            <span class="bg-ecruDark text-obsidian text-[11px] uppercase tracking-wider font-semibold px-3 py-1">
              Частные резиденции
            </span>
          </div>
          <div>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-obsidian mb-3">
              Пентхаусы, апартаменты и загородные виллы
            </h3>
            <p class="text-sm text-obsidian/70 leading-relaxed mb-6">
              Портьеры в пол со складками «Волна» и «Французская тройная», римские шторы, кашемировые покрывала и подушки. Идеальная тишина и рассеивание степного солнца Астаны.
            </p>
            <ul class="space-y-2.5 text-xs text-obsidian/85 mb-8">
              <li class="flex items-center gap-2"><span class="text-brass">✓</span> Бельгийский шенилл и итальянский бархат Dedar</li>
              <li class="flex items-center gap-2"><span class="text-brass">✓</span> Интеграция с Алисой и Apple HomeKit (Somfy)</li>
              <li class="flex items-center gap-2"><span class="text-brass">✓</span> Выезд дизайнера с чемоданом образцов на объект</li>
            </ul>
          </div>
          <button onclick="switchDoor('b2c'); document.getElementById('calculator').scrollIntoView({behavior: 'smooth'})" class="w-full bg-obsidian hover:bg-brass text-white text-xs uppercase tracking-widest font-semibold py-3.5 transition-colors">
            Рассчитать шторы для дома &rarr;
          </button>
        </div>

        <!-- Door 2: B2B Юрлица -->
        <div class="bg-obsidian text-white p-8 sm:p-10 border border-obsidianLight couture-card relative flex flex-col justify-between">
          <div class="flex justify-between items-start mb-6">
            <span class="font-serif text-4xl font-light text-brassLight/40">02</span>
            <span class="bg-white/10 text-brassLight text-[11px] uppercase tracking-wider font-semibold px-3 py-1">
              Бизнес & Юрлица (B2B)
            </span>
          </div>
          <div>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-3">
              Офисы, кабинеты директоров, отели и девелопмент
            </h3>
            <p class="text-sm text-white/70 leading-relaxed mb-6">
              Моторизованные системы Somfy Screen (подавление бликов), кассетный блэкаут для переговорных, негорючие ткани Trevira CS с пожарными сертификатами КМ1.
            </p>
            <ul class="space-y-2.5 text-xs text-white/85 mb-8">
              <li class="flex items-center gap-2"><span class="text-brassLight">✓</span> Официальный расчет с НДС 12%</li>
              <li class="flex items-center gap-2"><span class="text-brassLight">✓</span> Экспресс-КП по проектной ведомости за 2 часа</li>
              <li class="flex items-center gap-2"><span class="text-brassLight">✓</span> ЭДО: закрывающие строительные акты КС-2 / КС-3</li>
            </ul>
          </div>
          <button onclick="switchDoor('b2b'); document.getElementById('b2b-section').scrollIntoView({behavior: 'smooth'})" class="w-full bg-brass hover:bg-brassLight text-obsidian text-xs uppercase tracking-widest font-bold py-3.5 transition-colors">
            B2B Проектный отдел (НДС) &rarr;
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- ACT 3: B2C ТАКТИЛЬНЫЙ ИНКУБАТОР & СИМУЛЯТОР СКЛАДОК          -->
  <!-- ============================================================ -->
  <section id="calculator" class="flow-b2c py-20 bg-white border-b border-borderSubtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-borderSubtle pb-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-brass font-bold block mb-2">Интерактивный конфигуратор</span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-obsidian">Подбор складок и расчет стоимости (₸)</h2>
        </div>
        <p class="text-xs text-obsidian/60 max-w-md mt-3 md:mt-0">
          Выберите ткань, геометрию складки и габариты. Стоимость пересчитывается в реальном времени с учетом коэффициента расхода ткани.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left: Controls (8-Col) -->
        <div class="lg:col-span-8 space-y-8">
          
          <!-- Step 1: Pleat Type Selection -->
          <div>
            <label class="block text-xs uppercase tracking-wider font-bold text-obsidian mb-3">
              1. Выберите тип складки драпировки:
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <button id="btnPleat_wave" onclick="selectPleat('wave')" class="p-4 border-2 border-brass bg-brass/10 text-left transition-all">
                <div class="text-sm font-bold text-obsidian mb-1">Волна (Wave)</div>
                <div class="text-[11px] text-obsidian/70">Коэффициент 1:2.0 • Идеальный цилиндрический шаг</div>
              </button>
              <button id="btnPleat_french" onclick="selectPleat('french')" class="p-4 border border-borderSubtle bg-white hover:border-brass text-left transition-all">
                <div class="text-sm font-bold text-obsidian mb-1">Французская тройная</div>
                <div class="text-[11px] text-obsidian/70">Коэффициент 1:2.5 • Ручная защипка в 3 лепестка</div>
              </button>
              <button id="btnPleat_box" onclick="selectPleat('box')" class="p-4 border border-borderSubtle bg-white hover:border-brass text-left transition-all">
                <div class="text-sm font-bold text-obsidian mb-1">Бантовая (Box)</div>
                <div class="text-[11px] text-obsidian/70">Коэффициент 1:2.2 • Архитектурная симметрия</div>
              </button>
            </div>
            
            <!-- Real-time SVG Pleat Visualizer Profile -->
            <div class="mt-4 p-4 bg-ecru border border-borderSubtle">
              <div class="text-[10px] uppercase tracking-wider text-brass font-bold mb-1">Профиль складки карниза:</div>
              <div id="pleatShapeVisual" class="py-2"></div>
              <div id="calcPleatDesc" class="text-xs text-obsidian/70 mt-1 italic">
                Лаконичный ритм, шаг 16 см. Идеально для высоких потолков и новостроек.
              </div>
            </div>
          </div>

          <!-- Step 2: Fabric Category -->
          <div>
            <label class="block text-xs uppercase tracking-wider font-bold text-obsidian mb-3">
              2. Выберите категорию ткани:
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div id="cardFabric_chenille" onclick="selectFabric('chenille')" class="p-4 border border-brass ring-1 ring-brass bg-brass/5 cursor-pointer text-left transition-all">
                <span class="text-[10px] uppercase font-bold text-brass tracking-wider">Бельгия</span>
                <div class="text-xs font-bold text-obsidian mt-1">Шенилл Wind</div>
                <div class="text-[11px] text-obsidian/60 mt-1">24 500 ₸/м</div>
              </div>

              <div id="cardFabric_velvet" onclick="selectFabric('velvet')" class="p-4 border border-borderSubtle bg-white hover:border-brass cursor-pointer text-left transition-all">
                <span class="text-[10px] uppercase font-bold text-obsidian/50 tracking-wider">Италия</span>
                <div class="text-xs font-bold text-obsidian mt-1">Бархат Dedar</div>
                <div class="text-[11px] text-obsidian/60 mt-1">28 000 ₸/м</div>
              </div>

              <div id="cardFabric_linen" onclick="selectFabric('linen')" class="p-4 border border-borderSubtle bg-white hover:border-brass cursor-pointer text-left transition-all">
                <span class="text-[10px] uppercase font-bold text-obsidian/50 tracking-wider">Франция</span>
                <div class="text-xs font-bold text-obsidian mt-1">Лён Casamance</div>
                <div class="text-[11px] text-obsidian/60 mt-1">19 800 ₸/м</div>
              </div>

              <div id="cardFabric_blackout" onclick="selectFabric('blackout')" class="p-4 border border-borderSubtle bg-white hover:border-brass cursor-pointer text-left transition-all">
                <span class="text-[10px] uppercase font-bold text-obsidian/50 tracking-wider">Турция</span>
                <div class="text-xs font-bold text-obsidian mt-1">100% Blackout</div>
                <div class="text-[11px] text-obsidian/60 mt-1">16 500 ₸/м</div>
              </div>
            </div>
          </div>

          <!-- Step 3: Dimensions Sliders -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 bg-ecru p-6 border border-borderSubtle">
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs uppercase tracking-wider font-semibold text-obsidian/80">Ширина карниза</span>
                <span id="calcWidthVal" class="text-sm font-bold text-brass font-mono">3.2 м</span>
              </div>
              <input type="range" min="1.0" max="7.0" step="0.1" value="3.2" oninput="calcState.width = parseFloat(this.value); updateB2CCalculator();" class="w-full accent-brass">
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs uppercase tracking-wider font-semibold text-obsidian/80">Высота потолка</span>
                <span id="calcHeightVal" class="text-sm font-bold text-brass font-mono">3.0 м</span>
              </div>
              <input type="range" min="2.2" max="6.5" step="0.05" value="3.0" oninput="calcState.height = parseFloat(this.value); updateB2CCalculator();" class="w-full accent-brass">
            </div>
          </div>

          <!-- Step 4: Addon Options -->
          <div class="flex flex-wrap gap-6 pt-2">
            <label class="inline-flex items-center gap-2.5 text-xs text-obsidian cursor-pointer select-none">
              <input type="checkbox" checked onchange="calcState.includeTulle = this.checked; updateB2CCalculator();" class="w-4 h-4 accent-brass">
              <span>Добавить легкую французскую вуаль (тюль в пол)</span>
            </label>
            <label class="inline-flex items-center gap-2.5 text-xs text-obsidian cursor-pointer select-none">
              <input type="checkbox" onchange="calcState.includeSomfy = this.checked; updateB2CCalculator();" class="w-4 h-4 accent-brass">
              <span>Бесшумный электрокарниз Somfy Glydea Ultra (Умный Дом)</span>
            </label>
          </div>

        </div>

        <!-- Right: Real-time Costing Output (4-Col) -->
        <div class="lg:col-span-4 bg-ecru p-6 sm:p-8 border border-borderBrass couture-card">
          <span class="text-[10px] uppercase font-bold text-brass tracking-widest block mb-1">Предварительный расчет</span>
          <div class="text-3xl sm:text-4xl font-serif font-bold text-obsidian mb-1" id="calcTotalEstimate">
            40 395 ₸
          </div>
          <div class="text-xs text-obsidian/60 mb-6">под ключ с пошивом и тесьмой</div>

          <div class="space-y-3 text-xs text-obsidian/80 border-t border-borderSubtle pt-4 mb-6">
            <div class="flex justify-between">
              <span>Ткань:</span>
              <span id="calcFabricName" class="font-semibold text-right">Шенилл Wind</span>
            </div>
            <div class="flex justify-between">
              <span>Расход полотна:</span>
              <span id="calcMeters" class="font-semibold">6.8 пог. м</span>
            </div>
            <div class="flex justify-between">
              <span>Цеховой пошив:</span>
              <span id="calcTailoring" class="font-semibold">44 200 ₸</span>
            </div>
            <div class="flex justify-between">
              <span>Гарантия:</span>
              <span class="font-semibold text-emerald-700">3 года по договору</span>
            </div>
          </div>

          <button onclick="sendCalcToWhatsApp()" class="w-full bg-obsidian hover:bg-brass text-white text-xs uppercase tracking-widest font-semibold py-4 transition-all duration-300 mb-3">
            Зафиксировать расчет в WhatsApp
          </button>
          
          <button onclick="openSamplerModal()" class="w-full border border-borderBrass bg-white hover:bg-brass/10 text-obsidian text-xs uppercase tracking-widest font-semibold py-3 transition-colors">
            Пригласить замерщика на объект
          </button>
        </div>

      </div>
    </div>
  </section>

