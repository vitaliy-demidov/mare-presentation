  <section id="voice-ai" class="py-16 md:py-24 bg-obsidian text-white border-b border-obsidianLight relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <div class="inline-flex items-center gap-2 border border-brass/40 bg-white/5 text-brassLight text-[11px] uppercase tracking-widest font-semibold px-3.5 py-1.5 mb-6">
        <span>🎙️</span>
        <span>Voice AI Onboarding • Без клавиатуры</span>
      </div>

      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">
        Не нужно печатать на телефоне.<br><span class="italic font-normal text-brassLight">Просто скажите вслух.</span>
      </h2>

      <p id="voiceStatusLabel" class="text-sm text-white/70 max-w-lg mx-auto mb-10 leading-relaxed">
