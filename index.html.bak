  <!-- Load Master Engine JS -->
  <script src="app.js"></script>
  <script>
    function openSamplerModal() {
      const modal = document.getElementById('samplerModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeSamplerModal() {
      const modal = document.getElementById('samplerModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    function openWhatsAppModal() {
      const modal = document.getElementById('whatsAppModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeWhatsAppModal() {
      const modal = document.getElementById('whatsAppModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    function openWhatsAppForDesigner() {
      openWhatsAppModal();
      document.getElementById('waDesignerLink').click();
    }
    function handleSamplerSubmit(e) {
      e.preventDefault();
      alert('Благодарим! Заявка на выезд декоратора с чемоданом образцов принята. Мы свяжемся с вами в течение 10 минут для подтверждения времени.');
      closeSamplerModal();
    }
  </script>
